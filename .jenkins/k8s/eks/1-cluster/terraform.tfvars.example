# Copy to terraform.tfvars, which is gitignored, and edit.
#
#   cp 1-cluster/terraform.tfvars.example 1-cluster/terraform.tfvars
#
# Every value here has a default in variables.tf, so `tofu plan` runs with no tfvars file at all.  Read
# each variable's description before overriding it: the descriptions carry the consequence, not this file.
#
# No identifier in this file names a real thing, and none should.  A committed VPC identifier, subnet
# identifier, account number or address range is a fact about one account that everybody who clones this
# repository then carries.

# A name identifiable to you, which is the convention in ../../README.md.  Two clusters in one account
# must differ here: the name is in the Auto Scaling group tag the autoscaler discovers node groups by, so
# two clusters sharing it would scale each other's pools.
#cluster_name = "<whoami>--cassandra-jenkins"

# Small workers per admitted pipeline; concurrency follows the applied pool capacity.
#small_workers_per_build = 3

# Your closest low-carbon region.  AWS publishes that per region under its carbon methodology pages
# rather than through the API, so it cannot be derived here.
#region = "eu-north-1"

# Leave both unset to take the account's default VPC and its subnets in every zone the region offers; see
# availability_zone_count below to use fewer.  That is right for a throwaway cluster and wrong for a
# long-lived one: a default VPC's subnets are public, so the nodes get public addresses.
#vpc_id     = "<vpc identifier>"
#subnet_ids = ["<first subnet>", "<second subnet>"]

# How many zones the control plane's own subnets span, which is not the same question as the line above.
# EKS fixes this set at cluster creation and refuses to change it, so raising this on a running cluster
# means a new cluster: raise availability_zone_count instead, which the node groups follow.
#control_plane_zone_count = 2

# Unset, the default, uses every zone the region offers, which is four in us-west-2.  Set a number to use
# fewer; two is the EKS minimum.  Every agent pool becomes one node group per zone, so this multiplies the
# number of node groups: four pools over four zones is sixteen groups, each with a quarter of its pool's
# max_size.  More zones buy addresses, which is what the pools are sized against, and cost cross-zone
# transfer on every agent-to-controller connection.
#availability_zone_count = 2

# Who may reach the public Kubernetes API endpoint.  Unset means everywhere, which is the EKS default.
# Narrow it to the addresses that run kubectl and .build/run-ci.
#public_access_cidrs = ["<your address>/32"]

# Pin the control plane's Kubernetes minor.  Unset takes the newest EKS reports in standard support, and
# a later plan then proposes an upgrade with no change to this configuration.  EKS refuses to skip a
# minor, so a pin left stale for two releases has to be stepped one at a time.
#kubernetes_version = "1.34"

# Audit and authenticator are the two that answer "who changed the cluster", and neither can be turned on
# after the event it would have recorded.
#control_plane_log_types = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
#log_retention_days      = 30

# The controller's node.  It cannot scale to zero: the Jenkins controller is a StatefulSet with a bound
# 500Gi volume.
#controller_pool = {
#  instance_types = ["m7a.2xlarge"]
#  capacity_type  = "ON_DEMAND"
#  disk_gib       = 100
#}

# Agent pools, keyed by the size word in the cassandra.jenkins.agent.<size> node label.  Each pool becomes
# one node group per availability zone, and max_size is divided between them, so these are the pool's totals.
#
# No figures here, deliberately: variables.tf holds the defaults and the table of measured demand they come
# from, and a second copy of four numbers in a commented block is a second copy to leave stale.  Overriding
# this replaces the whole map, so copy the default out of variables.tf and edit that.
#
# Run ../3-smoke/check-pool-fit-test.sh, and then `make smoke`, after changing any instance type: the large
# pool's 17G of requests is 15.83 GiB, which does not fit a 16 GiB node.  Every type must be x86_64; the node
# groups say so as a precondition.
#
# capacity_type defaults to ON_DEMAND.  A reclaimed spot node is drained through the Eviction API, and
# the Jenkinsfile turns a drained agent into a failed branch, which failFast turns into a failed run.
# See variables.tf.  Setting capacity_type = "SPOT" on a pool opts that pool back in.
#agent_pools = {
#  small  = { instance_types = ["c7a.2xlarge"], capacity_type = "SPOT", max_size = <n> }
#  ...
#}

# Read the account's vCPU and EBS quotas at apply and scale every pool by the lowest ceiling they and the
# subnets allow, so a quota increase needs no edit here and a smaller account gets a smaller cluster that
# works.  Turn it off for a credential without servicequotas:GetServiceQuota; the subnet ceiling still
# applies.  quota_headroom is the share of each quota these pools may claim.
#size_pools_to_quotas = true
#quota_headroom       = 0.9

# Let EKS install vpc-cni, kube-proxy and CoreDNS itself.  False, and a new cluster should leave it false;
# see variables.tf.  Set it true only for a cluster created before this configuration existed, because the
# argument replaces the cluster.
#bootstrap_self_managed_addons = false

# EKS replaces a node it finds unhealthy, and the node monitoring agent add-on widens what that covers.
#node_auto_repair = true

# Both off, against what the EKS console offers. See variables.tf for why, and ../README.md.
#enable_cloudwatch_observability = false
#enable_external_dns             = false

# A public name for Jenkins, and TLS for it.  Leave all three unset and the cluster is reachable at its
# load balancer's own name, which is what a throwaway cluster wants.
#
# Set all three together.  enable_external_dns is what writes the address record; jenkins_hostname
# requests the certificate and becomes the URL Jenkins reports; dns_hosted_zone_id says which zone both
# of those work in.  The zone must be delegated at the registrar that holds the domain, which is the one
# step in this directory that cannot be scripted; see ../README.md.
#enable_external_dns = true
#jenkins_hostname    = "ci.<your-domain>"
#dns_hosted_zone_id  = "<hosted zone identifier>"

# Only for a cluster that serves a name in one zone and must write records in another.
# dns_hosted_zone_id is already included.
#external_dns_hosted_zone_ids = []

# What this cluster may spend, and what happens when it does.
#
# The three caps and the address do not belong here: `make caps` asks for them and writes
# spend-caps.auto.tfvars, which OpenTofu loads on its own, so that a generated file and a hand-edited one
# stay separate. `make apply` asks once when that file does not exist. Answering `none` to all three is an
# answer, and it means nothing watches what this cluster spends.
#
# The rest are here because they are rarely changed. See variables.tf for what each one costs.
#
# The interval is what the overshoot is measured in: the pools at full size are a few hundred dollars an
# hour, so a cap can be passed by an interval's worth of spend before the pools are stopped.
#spend_guard_interval_minutes = 5
#
# Both are used only until the guard has three settled days to fit them from; `make spend` says which is in
# force. See "A cap on what this cluster may spend" in ../README.md.
#spend_price_per_vcpu_hour = 0.06
#spend_fixed_usd_per_day   = 5
#
# UnblendedCost brakes on what is consumed; NetUnblendedCost nets credits out, so on a sponsored account it
# reads near zero and no cap is ever met.
#spend_cost_metric        = "UnblendedCost"
#spend_cost_refresh_hours = 6
#
# Two AWS Budgets for the console's own view of the same daily and monthly figures. They enforce nothing.
#enable_spend_budgets = true

#tags = {
#  Project   = "apache-cassandra-ci"
#  ManagedBy = "opentofu"
#  Owner     = "<whoami>"
#}
